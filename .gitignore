__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
out/
debug/
tests/_out/
bpc-run-*/

# local-only diagnostic folder -- nothing here is committed or pushed, except
# the README that explains what the folder is for (a fresh clone gets an empty
# directory otherwise, and no way to know why it exists)
analysis/*
!analysis/README.md

# scratch: one-off probes, smoke scripts and captured run output. These belong
# in analysis/scratch/, not at the root -- but they land at the root first, so
# ignore them there rather than let a stray _probe_*.py reach a commit.
/_*.py
/_*.log
/_*.txt
*.log

# a vendored third-party checkout (MIT), kept local, never committed
tools/DeepLSD/

# model weights are fetched on demand, never committed
models/*.pt
models/*.pth
models/*.onnx
models/*.safetensors
models/*.ckpt
models/*.tar

.idea/
.vscode/
