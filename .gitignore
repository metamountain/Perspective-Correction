__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
out/
debug/
tests/_out/
pc-run-*/

# local-only diagnostic folder -- nothing here is committed or pushed, except
# the README that explains what the folder is for (a fresh clone gets an empty
# directory otherwise, and no way to know why it exists)
analysis/*
!analysis/README.md

# scratch: one-off probes, smoke scripts and captured run output. These belong
# in analysis/scratch/, not at the root -- but they land at the root first, so
# ignore them there rather than let a stray _probe_*.py reach a commit.
/_*.py
/_*.log
/_*.txt
*.log

# a vendored third-party checkout (MIT), kept local, never committed
tools/DeepLSD/

# downloaded third-party weights: BiRefNet, Grounding DINO, SAM2/SAM3.  Several
# GB in total and five single files over GitHub's 100 MB hard limit, so a push
# containing them does not fail gracefully -- it is rejected outright.  All of
# them are re-downloadable, which is the same reason tools/DeepLSD/ is kept
# local.  The vendored M-LSD model above is the deliberate exception: small, and
# tracked on purpose (see models/LICENSE.mlsd).
models/BiRefNet/
models/GroundingDINO/
models/sam2/
models/sam3/

# model weights are fetched on demand, never committed
models/*.pt
models/*.pth
models/*.onnx
models/*.safetensors
models/*.ckpt
models/*.tar

.idea/
.vscode/
.qwen/

# local backups taken before a large doc edit; the content is in git history
*.bak

# trashed files (recoverable until manually deleted) and HPC save records
Trashcan/
verworfen/
hpc_save/

# Rendered synthetic scenes: `tools/render_synth.py` writes them here for
# visual inspection, and `test_assets._files()` does not glob this directory
# (it takes `assets/*` and `assets/Horizontal/*` only), so nothing in the
# suite reads them. 15 MB of output reproducible from one command does not
# belong in history -- run the generator instead.
tests/assets/Synthetic/
