__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
out/
debug/
tests/_out/
pc-run-*/

# local-only diagnostic folder -- nothing here is committed or pushed, except
# the README that explains what the folder is for (a fresh clone gets an empty
# directory otherwise, and no way to know why it exists)
analysis/*
!analysis/README.md

# scratch: one-off probes, smoke scripts and captured run output. These belong
# in analysis/scratch/, not at the root -- but they land at the root first, so
# ignore them there rather than let a stray _probe_*.py reach a commit.
/_*.py
/_*.log
/_*.txt
*.log

# a vendored third-party checkout (MIT), kept local, never committed
tools/DeepLSD/

# downloaded third-party weights: BiRefNet, Grounding DINO, SAM2/SAM3.  Several
# GB in total and five single files over GitHub's 100 MB hard limit, so a push
# containing them does not fail gracefully -- it is rejected outright.  All of
# them are re-downloadable, which is the same reason tools/DeepLSD/ is kept
# local.  The vendored M-LSD model above is the deliberate exception: small, and
# tracked on purpose (see models/LICENSE.mlsd).
models/BiRefNet/
models/GroundingDINO/
models/sam2/
models/sam3/

# model weights are fetched on demand, never committed
models/*.pt
models/*.pth
models/*.onnx
models/*.safetensors
models/*.ckpt
models/*.tar

.idea/
.vscode/

# The worker's own directory stays local -- `settings.json` is machine state
# and `tmp/` is where screenshots are told to land -- EXCEPT its skills, which
# are project knowledge and were invisible to everyone because of this line.
# 27 of them, ~200 KB of markdown, several recording lessons this repo paid
# for twice (the `_build` rebuild trap, canvas coordinate spaces, runtime
# theme switching). Scanned for secrets before un-ignoring; the API key lives
# in ~/.qwen/settings.json, not here.
.qwen/*
# ...and anywhere else it lands. The root pattern only anchors at the root, and a
# stray copy once appeared under tests/assets/Horizontal/ where a blanket
# `git add -A` would have taken it. settings.json is where the API key lives.
**/.qwen/settings.json
**/.qwen/tmp/
!.qwen/skills/

# local backups taken before a large doc edit; the content is in git history
*.bak

# trashed files (recoverable until manually deleted) and HPC save records
Trashcan/
verworfen/
correction_log/
hpc_save/

# Rendered synthetic scenes: `tools/render_synth.py` writes them here for
# visual inspection, and `test_assets._files()` does not glob this directory
# (it takes `assets/*` and `assets/Horizontal/*` only), so nothing in the
# suite reads them. 15 MB of output reproducible from one command does not
# belong in history -- run the generator instead.
tests/assets/Synthetic/

# Test photographs: 22 of them are TRACKED, the rest stay on the machine
# that collected them (user, 2026-09-22: "es reichen die 10 groessten...
# rest der bilder kann lokal bleiben").
#
# 46.3 MB in 101 files became 5.4 MB in 22. What is kept is not the
# largest -- those are 29.2 MB and include almost nothing any test names.
# It is: every file a test or tool opens BY NAME, the two `_ALWAYS`
# patterns `test_assets._sample` refuses to drop, four more so the pool
# sweeps still see a cross-section of real photographs (four container
# formats and one non-ASCII filename, which is the `_imread_unicode`
# path), and the cached mask beside each one.
#
# Checked by running the whole suite against a stripped clone, not by
# grepping: `test_assets:375` finds its photograph by SUBSTRING
# ("hospital"), so no search for a filename would have pointed at it, and
# dropping it turned a test that pins a real measurement into a silent
# skip. The stripped clone reports 350 passed, 2 skipped -- the same as a
# full one, and those two skips are older than this change.
#
# To track another: add a `!` line here. Everything else in the folder
# still works locally -- the sweeps simply see more here than CI does.
tests/assets/**
!tests/assets/Horizontal/
!tests/assets/masks/
!tests/assets/sam2_masks/
!tests/assets/1070912stkzg.jpg
!tests/assets/39079116-muenzstrasse-fassadenwerbung.jpg
!tests/assets/79cb33878fd0ed76d368e7cfa8827e15.jpg
!tests/assets/Alte_Scheune.jpg
!tests/assets/Horizontal/Mariánské_Hory,_panelové_domy_4.jpg
!tests/assets/Horizontal/Platte_1.jpg
!tests/assets/Horizontal/ultra-weitwinkelfassade-von-antibesrathaus-alias-hotel-de-ville-121561796.webp
!tests/assets/README.md
!tests/assets/Z6TgJJbqstJ9-T43_168_6869_r1.avif
!tests/assets/cedric-vilim-branding-bucerius-kunst-forum-34-eroeffnungskampagne-rathausmarkt.webp
!tests/assets/hospital-nikon-d60_f27.jpg
!tests/assets/lochfassade.jpg
!tests/assets/masks/1070912stkzg.png
!tests/assets/masks/39079116-muenzstrasse-fassadenwerbung.png
